// Secrets.example.xcconfig
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Config/Secrets.xcconfig is gitignored. Fill in the values you need; anything
// you leave as REPLACE_ME simply disables that integration at runtime with an
// actionable message instead of crashing.
//
// REMINDER: two forward slashes start a comment in xcconfig. Write URLs as
//   https:$(SLASH)$(SLASH)example.com
// $(SLASH) is defined in Base.xcconfig.
//
// Server-side secrets (Stripe especially) do NOT belong here — they go in the
// Convex environment. See docs/SETUP.md.

// ---------------------------------------------------------------------------
// App identity (optional here; Scripts/rename.sh edits Config/Base.xcconfig)
// ---------------------------------------------------------------------------
// APP_DISPLAY_NAME = My App
// APP_BUNDLE_ID = com.mycompany.myapp

// Apple Developer Team ID — required to run on a physical device.
// DEVELOPMENT_TEAM = ABCDE12345

// ---------------------------------------------------------------------------
// Clerk — dashboard.clerk.com → API keys → Publishable key
// ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY = pk_test_REPLACE_ME

// ---------------------------------------------------------------------------
// Convex — `npx convex dev` prints this, or dashboard.convex.dev → Settings
// ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT_URL = https:$(SLASH)$(SLASH)your-deployment-123.convex.cloud

// ---------------------------------------------------------------------------
// RevenueCat — app.revenuecat.com → Project → API keys → Apple App Store
// ---------------------------------------------------------------------------
REVENUECAT_API_KEY = appl_REPLACE_ME

// ---------------------------------------------------------------------------
// PostHog — us.posthog.com → Project settings → Project API key
// ---------------------------------------------------------------------------
POSTHOG_API_KEY = phc_REPLACE_ME
POSTHOG_HOST = https:$(SLASH)$(SLASH)us.i.posthog.com

// ---------------------------------------------------------------------------
// Sentry — sentry.io → Project → Settings → Client Keys (DSN)
// ---------------------------------------------------------------------------
SENTRY_DSN = https:$(SLASH)$(SLASH)examplePublicKey@o0.ingest.sentry.io/0

// ---------------------------------------------------------------------------
// OneSignal — app.onesignal.com → Settings → Keys & IDs → OneSignal App ID
// ---------------------------------------------------------------------------
ONESIGNAL_APP_ID = 00000000-0000-0000-0000-000000000000

// ---------------------------------------------------------------------------
// FeatureBase — there is no native iOS SDK. The app opens your hosted portal
// in a WKWebView sheet (see Services/FeatureBase). Use your portal URLs.
// ---------------------------------------------------------------------------
FEATUREBASE_PORTAL_URL = https:$(SLASH)$(SLASH)yourorg.featurebase.app
FEATUREBASE_CHANGELOG_URL = https:$(SLASH)$(SLASH)yourorg.featurebase.app/changelog

// ---------------------------------------------------------------------------
// Legal / support
// ---------------------------------------------------------------------------
PRIVACY_POLICY_URL = https:$(SLASH)$(SLASH)example.com/privacy
TERMS_URL = https:$(SLASH)$(SLASH)example.com/terms
SUPPORT_EMAIL = support@example.com
